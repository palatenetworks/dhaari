# Copy to .env.local for local development (used by `npm run dev`), and add the
# same variables in Vercel -> Project -> Settings -> Environment Variables for
# production.

# --- Email (Gmail SMTP, used by api/_email.ts) ---
# EMAIL_PASSWORD must be a Gmail App Password (Google Account -> Security ->
# 2-Step Verification -> App passwords), NOT the normal account password.
EMAIL_SENDER=dhaariinfo@gmail.com
EMAIL_PASSWORD=
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465

# --- Razorpay (used by api/create-order.ts and api/verify-payment.ts) ---
# From Razorpay Dashboard -> Settings -> API Keys. The secret is server-only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
